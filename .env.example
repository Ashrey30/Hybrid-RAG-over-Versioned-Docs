# Required by the default Groq answer-generation configuration.
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional: required only if config.yaml is changed to use Gemini.
# GEMINI_API_KEY=

# Optional: set to true when serving over HTTPS.
AUTH_COOKIE_SECURE=false

# Set to 1 only for local debugging. Do not enable in production.
RAG_DEBUG=0
